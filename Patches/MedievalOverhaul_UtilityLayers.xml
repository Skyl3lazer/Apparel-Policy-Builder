<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- Example: flag another mod's layers as 'utility'. Guard each on the layer def existing (PatchOperationConditional),
       not MayRequire - patch operations ignore MayRequire and would log a red error when the mod is absent. -->

  <!-- Medieval Overhaul's jewelry and attachment layers count as utility. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ApparelLayerDef[defName="DankPyon_NecklaceLayer"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/ApparelLayerDef[defName="DankPyon_NecklaceLayer"]</xpath>
      <value>
        <li Class="ApparelPolicyBuilder.UtilityLayerExtension" />
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ApparelLayerDef[defName="DankPyon_Ring1Layer"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/ApparelLayerDef[defName="DankPyon_Ring1Layer"]</xpath>
      <value>
        <li Class="ApparelPolicyBuilder.UtilityLayerExtension" />
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ApparelLayerDef[defName="DankPyon_ShellAttachment"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/ApparelLayerDef[defName="DankPyon_ShellAttachment"]</xpath>
      <value>
        <li Class="ApparelPolicyBuilder.UtilityLayerExtension" />
      </value>
    </match>
  </Operation>

</Patch>
