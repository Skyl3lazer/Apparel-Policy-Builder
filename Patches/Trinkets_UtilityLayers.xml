<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Bundle of Trinkets: neck-trinket layer is utility. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ApparelLayerDef[defName="Seti_TrinketLayer"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/ApparelLayerDef[defName="Seti_TrinketLayer"]</xpath>
      <value>
        <li Class="ApparelPolicyBuilder.UtilityLayerExtension" />
      </value>
    </match>
  </Operation>

</Patch>
