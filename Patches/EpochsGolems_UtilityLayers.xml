<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- Epochs - Golems: waist bag attachment layer is utility. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ApparelLayerDef[defName="DV_ShellAttachment"]</xpath>
    <match Class="PatchOperationAddModExtension">
      <xpath>Defs/ApparelLayerDef[defName="DV_ShellAttachment"]</xpath>
      <value>
        <li Class="ApparelPolicyBuilder.UtilityLayerExtension" />
      </value>
    </match>
  </Operation>

</Patch>
